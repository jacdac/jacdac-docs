---
import LegacyMakeCodeSimIsland from '../../components/tools/LegacyMakeCodeSimIsland';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>MakeCode Simulator</title>
  </head>
  <body>
    <main style="max-width: 1080px; margin: 2rem auto 4rem; padding: 0 1rem; font-family: ui-sans-serif, system-ui, sans-serif; display: grid; gap: 1rem;">
      <p style="margin: 0; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: #6b7280;">Web Tools</p>
      <h1 style="margin: 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05;">MakeCode Simulator</h1>
      <p style="margin: 0; color: #4b5563; max-width: 56rem;">
        Launch Jacdac simulators and click Add blocks to send extension suggestions to MakeCode.
      </p>

      <section style="border: 1px solid #e5e7eb; border-radius: 16px; padding: 1rem; background: #fff;">
        <LegacyMakeCodeSimIsland client:only="react" />
      </section>
    </main>
  </body>
</html>
