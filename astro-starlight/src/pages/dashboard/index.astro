---
import DashboardMigrationPanel from '../../components/dashboard/DashboardMigrationPanel';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Device Dashboard</title>
  </head>
  <body>
    <main style="max-width: 1080px; margin: 2rem auto 4rem; padding: 0 1rem; font-family: ui-sans-serif, system-ui, sans-serif; display: grid; gap: 1rem;">
      <p style="margin: 0; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: #6b7280;">Device Dashboard</p>
      <h1 style="margin: 0; font-size: clamp(2.1rem, 4vw, 3.2rem); line-height: 1.05;">Device Dashboard</h1>
      <p style="margin: 0; color: #4b5563; max-width: 56rem;">
        Dashboard migration is now anchored in Astro. While the full React dashboard is being integrated,
        you can still use the existing dashboard implementation.
      </p>

      <DashboardMigrationPanel client:load />

      <section style="border: 1px solid #e5e7eb; border-radius: 16px; overflow: hidden; background: #fff;">
        <iframe
          title="Jacdac Device Dashboard"
          src="https://jacdac.github.io/jacdac-docs/dashboard/?embed=1"
          style="width: 100%; min-height: 72vh; border: 0; display: block;"
        ></iframe>
      </section>

      <p style="margin: 0; color: #6b7280;">
        If the embedded dashboard does not load, open it directly:
        <a href="https://jacdac.github.io/jacdac-docs/dashboard/" style="margin-left: 0.35rem;">jacdac.github.io/jacdac-docs/dashboard/</a>
      </p>
    </main>
  </body>
</html>
