---
import { devicePath, getDevices } from '../../lib/specData';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const pathsByProductId = new Map<string, { params: { productId: string }; props: { toPath: string } }>();
  for (const device of getDevices()) {
    for (const productId of device.productIdentifiers || []) {
      const key = productId.toString(16);
      if (!pathsByProductId.has(key)) {
        pathsByProductId.set(key, {
          params: { productId: key },
          props: { toPath: devicePath(device) },
        });
      }
    }
  }
  return [...pathsByProductId.values()];
}

const { toPath } = Astro.props as { toPath: string };
return Astro.redirect(`${base}${toPath.replace(/^\//, '')}`, 302);
