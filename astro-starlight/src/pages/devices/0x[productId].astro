---
import { devicePath, getDevices } from '../../lib/specData';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const paths: Array<{ params: { productId: string }; props: { toPath: string } }> = [];
  for (const device of getDevices()) {
    for (const productId of device.productIdentifiers || []) {
      paths.push({
        params: { productId: productId.toString(16) },
        props: { toPath: devicePath(device) },
      });
    }
  }
  return paths;
}

const { toPath } = Astro.props as { toPath: string };
return Astro.redirect(`${base}${toPath.replace(/^\//, '')}`, 302);
---
