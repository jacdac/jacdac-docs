---
import { companySlug, getDevices } from '../../../lib/specData';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  const companies = Array.from(new Set(getDevices().map((device) => device.company)));
  return companies.map((company) => ({
    params: { company: companySlug(company) },
    props: {
      company,
      devices: getDevices().filter((device) => companySlug(device.company) === companySlug(company)),
    },
  }));
}

const { company, devices } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{company} devices</title>
  </head>
  <body>
    <main style="max-width: 920px; margin: 2rem auto; padding: 0 1rem; font-family: ui-sans-serif, system-ui, sans-serif;">
      <p><a href={`${base}devices/`}>Device Catalog</a></p>
      <h1>{company} devices</h1>
      <ul>
        {devices.map((device: { id: string; name: string; company: string }) => {
          const slug = companySlug(device.company);
          const deviceSlug = device.id.startsWith(`${slug}-`) ? device.id.slice(slug.length + 1) : device.id;
          return <li><a href={`${base}devices/${slug}/${deviceSlug}/`}>{device.name}</a></li>;
        })}
      </ul>
    </main>
  </body>
</html>
