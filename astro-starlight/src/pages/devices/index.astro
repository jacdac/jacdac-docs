---
import { basePathPrefix, companySlug, deviceImagePath, devicePath, getDevices } from '../../lib/specData';

const devices = getDevices().slice().sort((a, b) => a.company.localeCompare(b.company) || a.name.localeCompare(b.name));
const companies = Array.from(new Set(devices.map((device) => device.company))).sort();
const base = basePathPrefix();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Device Catalog</title>
  </head>
  <body>
    <main style="max-width: 1120px; margin: 2rem auto 4rem; padding: 0 1rem; font-family: ui-sans-serif, system-ui, sans-serif;">
      <div style="display: grid; gap: 0.75rem; margin-bottom: 2rem;">
        <p style="margin: 0; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: #6b7280;">Device Catalog</p>
        <h1 style="margin: 0; font-size: clamp(2.25rem, 4vw, 3.5rem); line-height: 1.05;">Device Catalog</h1>
        <p style="margin: 0; max-width: 58rem; color: #4b5563; font-size: 1.05rem;">Generated from the Jacdac device spec data set, with image derivatives rendered from the sibling spec repo.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {companies.map((company) => (
            <a href={`${base}devices/${companySlug(company)}/`} style="display: inline-flex; align-items: center; border: 1px solid #d1d5db; border-radius: 999px; padding: 0.45rem 0.85rem; text-decoration: none; color: #111827; background: #fff;">
              {company}
            </a>
          ))}
        </div>
      </div>

      <section>
        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem;">
          <h2 style="margin: 0; font-size: 1.4rem;">Devices</h2>
          <p style="margin: 0; color: #6b7280;">{devices.length} entries</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
          {devices.map((device) => {
            const path = devicePath(device);
            const tags = (device.tags || []).slice(0, 3);
            return (
              <a
                href={`${base}${path.replace(/^\//, '')}`}
                style="display: grid; border: 1px solid #e5e7eb; border-radius: 20px; text-decoration: none; color: inherit; background: linear-gradient(180deg, #fff, #fafafa); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04); overflow: hidden;"
              >
                <img
                  loading="lazy"
                  alt={device.name}
                  src={deviceImagePath(device, 'preview')}
                  width="480"
                  height="360"
                  style="width: 100%; height: auto; display: block; background: #f3f4f6;"
                />
                <div style="display: grid; gap: 0.45rem; padding: 1rem;">
                  <div style="display: flex; justify-content: space-between; gap: 0.75rem; align-items: flex-start;">
                    <h3 style="margin: 0; font-size: 1.08rem; line-height: 1.2;">{device.name}</h3>
                    <span style="font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em;">{device.company}</span>
                  </div>
                  {device.description && <p style="margin: 0; color: #4b5563; font-size: 0.95rem; line-height: 1.45;">{device.description}</p>}
                  {tags.length > 0 && (
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                      {tags.map((tag) => (
                        <span style="display: inline-flex; align-items: center; padding: 0.2rem 0.55rem; border-radius: 999px; background: #eef2ff; color: #3730a3; font-size: 0.76rem;">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    </main>
  </body>
</html>
